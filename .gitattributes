# Default: auto-detect text, normalize to LF in repo
* text=auto

# Source and docs — enforce LF in repo and on checkout
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf

# Windows scripts keep CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary — never normalize or diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.gz   binary
*.pdf  binary
*.pyc  binary
