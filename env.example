# =============================================================================
# FreelancerClaw — environment variables template
#
# This file is named `env.example` (no leading dot). To activate it, copy to a
# file named `.env` in the FreelancerClaw folder and fill in real values:
#
#     copy env.example .env        (Windows cmd, inside FreelancerClaw\)
#     cp env.example .env          (Linux/macOS)
#
# NEVER commit `.env` to version control (see .gitignore).
#
# Credentials may ALSO be supplied via OpenWebUI Valves (see README.md).
# Precedence: OpenWebUI Valves  >  environment variables. No hardcoded secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Freelancer.com — personal Access Token (direct token, NO OAuth flow,
# no client_id, no client_secret, no refresh_token)
# Where: https://accounts.freelancer.com/settings/develop
#        -> Personal Access Token / API token -> copy the value
# Sent as: Authorization: Bearer <token> on every call to
#          https://www.freelancer.com/api
# If any request returns 401, the agent halts the cycle and sends a Telegram
# alert asking you to regenerate the token.
# -----------------------------------------------------------------------------
FREELANCER_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Telegram — bot credentials for the draft-approval workflow
# 1. In Telegram, message @BotFather -> /newbot -> follow the prompts
# 2. Copy the bot token into TELEGRAM_BOT_TOKEN below.
# 3. Send ANY message to your new bot (this is required), then open
#    https://api.telegram.org/bot<PASTE_TOKEN_HERE>/getUpdates
#    and copy the numeric "chat"."id" value into TELEGRAM_CHAT_ID.
# Drafts are pushed here; you reply "approve <bid_id>" / "reject <bid_id>".
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# GitHub — fine-grained Personal Access Token for portfolio summarization
# Where: https://github.com/settings/personal-access-tokens/new
#        Repository access: "All repositories" or select your repos
#        Permissions -> Contents: Read-only   (minimum needed)
# Used to list repos (api.github.com/user/repos) and fetch READMEs.
# Results are cached locally for 24 hours — not re-fetched on every scan.
# -----------------------------------------------------------------------------
GITHUB_PAT=

# =============================================================================
# TUNING — all optional. Every value below is the documented default.
#
# Precedence (highest wins):
#     OpenWebUI Valves  >  environment variables  >  defaults in this file
#
# scheduler.py is runnable standalone from .env alone:  python scheduler.py
# =============================================================================

# Comma-separated search keywords. Each keyword becomes one API query per
# scan cycle (GET /projects/0.1/projects/active?query=...).
SEARCH_KEYWORDS=python automation,web scraping,telegram bot,pdf extraction,LLM integration,data analysis

# Minimum total score (0-100) for a project to qualify for proposal drafting.
SCORE_THRESHOLD=70

# Minimum acceptable budget minimum, in USD. Non-USD budgets are converted
# via currency.exchange_rate from the API. Below this, budget_fit scores 0.
MIN_BUDGET=100

# Hard caps on SUBMITTED bids (not drafts). When a cap is reached, drafting
# is paused until the window resets.
MAX_BIDS_PER_DAY=1
MAX_BIDS_PER_MONTH=6

# Minutes between scan cycles. Clamped to a minimum of 15 at runtime.
SCAN_INTERVAL_MINUTES=30

# Comma-separated exclusion keywords. A hit in the project title or
# preview_description discards the project entirely (score 0, no drafting).
EXCLUDED_KEYWORDS=crypto,adult,captcha bypass,guaranteed returns,profit guarantee,whatsapp business api,linkedin automation,cold email

# true  = never submit; approve_bid() returns the draft text for manual copy.
# false = approve_bid() submits via place_bid() (still approval-gated, and
#         still blocked until the user approves a first draft manually).
DRAFT_ONLY=true
